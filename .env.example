# Names only. Copy to .env and fill in values locally. Never commit real values.
DATABASE_URI=
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
CONTACT_INBOX=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
REVALIDATE_SECRET=
SENTRY_DSN=

# Phase 2: M-PESA Express (Daraja)
MPESA_ENV=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_TOKEN=

# Seed script (npm run seed): first super-admin. Never commit real values.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Cookieless analytics (Plausible or Umami). The script loads only when NEXT_PUBLIC_ANALYTICS_SRC is set.
NEXT_PUBLIC_ANALYTICS_SRC=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_WEBSITE_ID=

# Optional: points the Turnstile check at a local stand-in. Tests only. Defaults to Cloudflare.
TURNSTILE_VERIFY_URL=
