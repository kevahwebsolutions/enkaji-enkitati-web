{
  "name": "enkaji-enkitati-web",
  "version": "1.0.0",
  "description": "Enkaji Enkitati CBO website and CMS",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "format": "prettier --write .",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed/index.ts",
    "test": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "brand:assets": "tsx scripts/brand-assets.ts",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "check:privacy": "tsx scripts/check-privacy.ts",
    "mail:dev": "docker run --rm --name enkaji-mail -p 1025:1025 -p 8025:8025 axllent/mailpit"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^5.9.1",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "date-fns": "^4.4.0",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "next": "16.3.3",
    "nodemailer": "^10.1.0",
    "payload": "3.90.2",
    "radix-ui": "^1.7.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "sharp": "0.35.4",
    "simple-icons": "^16.35.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "fast-xml-parser": "^5.11.2",
    "ical.js": "^2.2.1",
    "imagetracerjs": "^1.2.6",
    "jsdom": "28.0.0",
    "postcss": "^8.5.29",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true
}
